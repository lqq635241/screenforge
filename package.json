{
  "name": "screenforge",
  "private": true,
  "version": "0.1.0",
  "description": "开源大屏搭建器 —— 拖拽 ECharts、主题换肤、导出 HTML / Vue / React 工程",
  "type": "module",
  "scripts": {
    "dev": "npm run build:runtime && vite",
    "build": "npm run build:runtime && vite build",
    "build:runtime": "esbuild src/core/runtime-entry.ts --bundle --minify --format=iife --global-name=ScreenForgeCore --target=es2018 --outfile=src/export/runtime.iife.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
